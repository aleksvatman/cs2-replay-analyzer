# Copy to .env and edit.

# Your domain; its DNS A/AAAA record must point at this machine. Caddy gets the certificate itself.
SITE_ADDRESS=cs2.example.com

# Required. Generate with: openssl rand -hex 32
API_TOKEN=

# Memory per parse is about 0.9 GB (docs/measurements.md). With 1 parallel parse give the
# container 2500m, with 2 about 3500m.
MAX_PARALLEL_PARSES=1
SERVER_MEMORY_LIMIT=2500m

# Optional, defaults shown.
#MAX_QUEUE=8
#MAX_UPLOADS=4
#MAX_MATCHES=200
#MAX_UPLOAD_BYTES=1073741824
#RATE_LIMIT_PER_MINUTE=600
# Delete finished matches after this many days (0 = never).
#RETENTION_DAYS=0
# true keeps the .dem after parsing (needed for POST /matches/{id}/reparse) and uses disk.
#KEEP_DEM=false
#RUST_LOG=info
# Ports on the host (change only for a local test).
#HTTP_PORT=80
#HTTPS_PORT=443
